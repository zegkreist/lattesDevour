# Copie para .env e ajuste. Tudo é opcional; os padrões sobem local.
POSTGRES_USER=lattes
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lattes

# uid/gid do dono da pasta ./data/app no host (id -u / id -g)
LATTES_UID=1000
LATTES_GID=1000

APP_PORT=8080
NOVNC_PORT=6080
# Senha do VNC do navegador do coletor (recomendado se for expor além de localhost)
VNC_PASSWORD=

# Se o Lattes mudar a URL da página do CV, ajuste aqui sem rebuild ({id} = ID Lattes).
LATTES_CV_URL=
CAPTCHA_TIMEOUT_MS=600000

# 2Captcha: a chave pode ser cadastrada na aba Coleta (vale sobre esta). Vazio nos dois = humano via noVNC.
# O ritmo (60 a 180 CVs/hora, padrão 60) se ajusta na aba Coleta.
TWOCAPTCHA_API_KEY=
TWOCAPTCHA_TIMEOUT_MS=180000

# CVs processados (parse + gravação) ao mesmo tempo (1 a 8).
PARSE_CONCORRENCIA=4

# Backup na nuvem (pré-configurado, desligado enquanto o bucket estiver vazio).
# Credenciais AWS: use um usuário só com s3:PutObject no prefixo.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=lattes-devour/
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Hora (Brasília) do backup diário; 0 desliga o agendamento (o botão manual continua).
BACKUP_HOUR=3
BACKUP_KEEP=7
